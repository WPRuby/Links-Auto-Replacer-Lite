parameters:
	ignoreErrors:
		-
			message: '#^PHPDoc tag @param has invalid value \(StdObject the post object\)\: Unexpected token "the", expected variable at offset 68 on line 3$#'
			identifier: phpDoc.parseError
			count: 1
			path: admin/class-lar-admin.php

		-
			message: '#^PHPDoc tag @param has invalid value \(array default admin colums heads\.\)\: Unexpected token "default", expected variable at offset 88 on line 3$#'
			identifier: phpDoc.parseError
			count: 1
			path: admin/class-lar-admin.php

		-
			message: '#^PHPDoc tag @param has invalid value \(integer the post ID\.\)\: Unexpected token "the", expected variable at offset 76 on line 3$#'
			identifier: phpDoc.parseError
			count: 1
			path: admin/class-lar-admin.php

		-
			message: '#^Method Lar_Lite_Settings\:\:get_option\(\) should return string but returns array\.$#'
			identifier: return.type
			count: 1
			path: admin/classes/class-settings.php

		-
			message: '#^PHPDoc tag @param has invalid value \(string the option''s key\.\)\: Unexpected token "the", expected variable at offset 51 on line 3$#'
			identifier: phpDoc.parseError
			count: 1
			path: admin/classes/class-settings.php

		-
			message: '#^PHPDoc tag @param has invalid value \(integer link ID\)\: Unexpected token "link", expected variable at offset 83 on line 3$#'
			identifier: phpDoc.parseError
			count: 1
			path: admin/classes/class.link.php

		-
			message: '#^Variable \$this might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: admin/partials/about.php

		-
			message: '#^Variable \$this might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: admin/partials/menu.php

		-
			message: '#^Variable \$this might not be defined\.$#'
			identifier: variable.undefined
			count: 2
			path: admin/partials/settings.php
