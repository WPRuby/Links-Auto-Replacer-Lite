<?xml version="1.0"?>
<ruleset name="Keywords to Links Converter">
	<description>Security and PHP compatibility checks. Style rules are added as the code is modernized.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<!-- The bundled CMB2 library, removed in 3.0. -->
	<exclude-pattern>/admin/cmb/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<!-- Warnings are reported but don't fail CI. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="links-auto-replacer"/>
			</property>
		</properties>
	</rule>
</ruleset>
